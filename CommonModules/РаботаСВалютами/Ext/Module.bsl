// Функция возвращает актуальный курс валюты на указанную дату.
// Если курс в базе не найден, возвращает 1 (чтобы не делить на ноль при пересчете).
Функция ПолучитьКурсВалюты(АктуальнаяДата, ИскомаяВалюта) Экспорт
	
	// Если валюта не указана, пересчет не требуется
	Если Не ЗначениеЗаполнено(ИскомаяВалюта) Тогда
		Возврат 1;
	КонецЕсли;
	
	// Строим запрос к срезу последних регистра сведений
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КурсыВалютСрезПоследних.Курс КАК Курс
		|ИЗ
		|	РегистрСведений.КурсыВалют.СрезПоследних(&Период, Валюта = &Валюта) КАК КурсыВалютСрезПоследних";
		
	Запрос.УстановитьParamетр("Период", АктуальнаяДата);
	Запрос.УстановитьПараметр("Валюта", ИскомаяВалюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Курс;
	Иначе
		// Если курса нет в базе, возвращаем 1, чтобы не искажать рублевые суммы
		Возврат 1;
	КонецЕсли;
	
КонецФункции
