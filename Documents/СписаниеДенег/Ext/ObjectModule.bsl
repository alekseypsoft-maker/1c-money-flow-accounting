Процедура ОбработкаПроведения(Отказ, Режим)
	
	// 1. Сначала подготавливаем запрос к регистру, чтобы узнать текущий остаток
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&Период,
		|			Кошелёк = &Кошелёк
		|				И Валюта = &Валюта) КАК ОстаткиДенежныхСредствОстатки";
	
	// Передаем параметры в запрос из текущего документа
	Запрос.УстановитьПараметр("Период",  МоментВремени());
	Запрос.УстановитьПараметр("Кошелёк", Кошелёк); // Проверьте букву Е/Ё в имени вашего реквизита!
	Запрос.УстановитьПараметр("Валюта",  Кошелёк.Валюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТекущийОстаток = 0;
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ТекущийОстаток = Выборка.СуммаОстаток;
	КонецЕсли;
	
	// 2. Проверяем, хватает ли денег для списания
	Если ТекущийОстаток < Сумма Тогда
		Отказ = Истина; // Этот флаг отменяет проведение документа
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Недостаточно средств в кошельке! Доступно: " + ТекущийОстаток + ", требуется: " + Сумма;
		Сообщение.Сообщить();
		Возврат; // Прерываем выполнение, дальше код не пойдет
	КонецЕсли;

	// 3. Если денег хватает, делаем стандартное движение расхода
	Движения.ОстаткиДенежныхСредств.Записывать = Истина;
	Движение = Движения.ОстаткиДенежныхСредств.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Кошелёк = Кошелёк;
	Движение.Валюта = Кошелёк.Валюта;
	Движение.Сумма = Сумма;

КонецПроцедуры
