Процедура ОбработкаПроведения(Отказ, Режим)
	
	// 1. Проверяем остаток на кошельке-отправителе
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&Период,
		|			Кошелёк = &Кошелёк
		|				И Валюта = &Валюта) КАК ОстаткиДенежныхСредствОстатки";
	
	Запрос.УстановитьПараметр("Период",  МоментВремени());
	Запрос.УстановитьПараметр("Кошелёк", КошелекОтправитель); // Проверьте букву Е/Ё!
	Запрос.УстановитьПараметр("Валюта",  КошелекОтправитель.Валюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТекущийОстаток = 0;
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ТекущийОстаток = Выборка.СуммаОстаток;
	КонецЕсли;
	
	// 2. Блокируем перевод, если денег не хватает
	Если ТекущийОстаток < Сумма Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Недостаточно средств для перевода! На кошельке-отправителе доступно: " + ТекущийОстаток + ", требуется: " + Сумма;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	// 3. Если всё хорошо, выполняем двойное движение
	Движения.ОстаткиДенежныхСредств.Записывать = Истина;
	
	// Списание (Расход)
	ДвижениеРасход = Движения.ОстаткиДенежныхСредств.Добавить();
	ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
	ДвижениеРасход.Период      = Дата;
	ДвижениеРасход.Кошелёк     = КошелекОтправитель;
	ДвижениеРасход.Валюта      = КошелекОтправитель.Валюта;
	ДвижениеРасход.Сумма       = Сумма;

	// Зачисление (Приход)
	ДвижениеПриход = Движения.ОстаткиДенежныхСредств.Добавить();
	ДвижениеПриход.ВидДвижения = ВидДвиженияНакопления.Приход;
	ДвижениеПриход.Период      = Дата;
	ДвижениеПриход.Кошелёк     = КошелекПолучатель;
	ДвижениеПриход.Валюта      = КошелекПолучатель.Валюта;
	ДвижениеПриход.Сумма       = Сумма;

КонецПроцедуры
